    rate = str(risk_free_rate).strip().replace("%", "")
    try:
        rate = f"{float(rate):.2f}"
    except ValueError:
        pass
    return f"*Risk-free rate assumed to be {rate}% (FBIL OVERNIGHT MIBOR as on {format_date_with_ordinal(mibor_date)}). Ratios calculated on the basis of 3 years history of monthly data."


def add_ubuntu_6_run(paragraph, text):
    run = paragraph.add_run()
    run.text = text
    run.font.name = NOTE_FONT_NAME
    run.font.size = NOTE_FONT_SIZE
    return run


def append_text_to_shape(shape, note_text):
    if not shape_has_text(shape):
        return False, "not_text_shape"
    if note_already_exists(shape, note_text):
        return True, "already_exists"
    text_frame = shape.text_frame
    existing = text_frame.text or ""
    paragraph = text_frame.add_paragraph() if existing.strip() else text_frame.paragraphs[0]
    if not existing.strip():
        text_frame.clear()
        paragraph = text_frame.paragraphs[0]
    add_ubuntu_6_run(paragraph, note_text)
    return True, "added"


def find_launch_date_in_slide(slide):
    lines = [line.strip() for line in get_slide_text(slide).splitlines() if line.strip()]
    for idx, line in enumerate(lines):
        if any(label in normalize_text_for_match(line) for label in LAUNCH_DATE_LABELS):
            parsed = parse_date(line)
            if parsed:
                return parsed
            for nearby in lines[idx + 1: idx + 4]:
                parsed = parse_date(nearby)
                if parsed:
                    return parsed
    return None


def detect_fund_name_from_slide(slide):
    candidates = []
    for shape in iter_shapes(slide.shapes):
        text = clean_text(get_shape_text(shape))
        if not text:
            continue
        for line in text.splitlines():
            line = clean_text(line)
            norm = normalize_text_for_match(line)
            if "bandhan" in norm and "fund" in norm and len(line) <= 120:
                candidates.append(line)
    return sorted(set(candidates), key=lambda item: (len(item), item))[0] if candidates else ""


def load_launch_dates_from_excel(excel_path, sheet_name=None, log=None):
    if not excel_path:
        return {}
    workbook = load_workbook(excel_path, data_only=True, read_only=True)
    mapping = {}
    try:
        sheets = [workbook[sheet_name]] if sheet_name else workbook.worksheets
        for worksheet in sheets:
            rows = list(worksheet.iter_rows(min_row=1, max_row=min(worksheet.max_row or 0, 1000), min_col=1, max_col=min(worksheet.max_column or 0, 80), values_only=True))
            for header_idx, row in enumerate(rows[:25]):
                headers = [normalize_text_for_match(value) for value in row]
                fund_col = None
                launch_col = None
                for col_idx, header in enumerate(headers):
                    if fund_col is None and ("scheme name" in header or "fund name" in header or header in {"scheme", "fund"}):
                        fund_col = col_idx
                    if launch_col is None and ("launch date regular" in header or "regular launch date" in header or ("launch date" in header and "regular" in header) or "inception date regular" in header):
                        launch_col = col_idx
                if launch_col is None:
                    for col_idx, header in enumerate(headers):
                        if "launch date" in header or "inception date" in header:
                            launch_col = col_idx
                            break
                if fund_col is None or launch_col is None:
                    continue
                for data_row in rows[header_idx + 1:]:
                    if fund_col >= len(data_row) or launch_col >= len(data_row):
                        continue
                    fund_name = clean_text(data_row[fund_col])
                    launch_date = parse_date(data_row[launch_col])
                    if fund_name and launch_date:
                        mapping[fund_name] = launch_date
                if mapping:
                    if log:
                        log(f"Loaded {len(mapping)} launch dates from Excel sheet '{worksheet.title}'.")
                    return mapping
        return mapping
    finally:
        workbook.close()


def find_launch_date_for_fund(fund_name, launch_date_map):
    if not fund_name or not launch_date_map:
        return None, 0.0, ""
    best_name = ""
    best_date = None
    best_score = 0.0
    for excel_fund_name, launch_date in launch_date_map.items():
        score = similarity(fund_name, excel_fund_name)
        if score > best_score:
            best_score = score
            best_name = excel_fund_name
            best_date = launch_date
    return (best_date, best_score, best_name) if best_score >= 0.35 else (None, best_score, best_name)


def build_notes_by_age(launch_date, as_of_date, risk_free_rate, mibor_date):
    age_years = completed_years(launch_date, as_of_date)
    notes = [build_risk_free_note(risk_free_rate, mibor_date) if age_years >= 3 else SHORT_TIMEFRAME_NOTE]
    notes.append(PORTFOLIO_TURNOVER_NOTE if age_years >= 1 else SHORT_TIMEFRAME_NOTE)
    if 1 <= age_years < 5:
        notes.append(ONE_TO_FIVE_YEAR_NOTE)
    unique_notes = []
    seen = set()
    for note in notes:
        key = canonical_note_key(note)
        if key not in seen:
            unique_notes.append(note)
            seen.add(key)
    return unique_notes, age_years


def detect_age_ppt_category(pptx_path: Path) -> tuple[int, str] | None:
    key = normalize_file_key(pptx_path.stem)
    # Check passive first so equity_passive does not get classified as Equity.
    for order in [3, 4, 0, 1, 2]:
        label, patterns = AGE_PPT_DETECTION_GROUPS[order]
        for pattern in patterns:
            if pattern in key:
                return order, label
    return None


def detect_age_based_pptx_files(source_folder: str | Path) -> list[Path]:
    folder = Path(source_folder)
    if not folder.exists() or not folder.is_dir():
        return []

    matched: list[tuple[int, str, Path]] = []
    seen: set[Path] = set()
    for pptx_path in folder.glob("*.pptx"):
        if pptx_path.name.startswith("~$"):
            continue
        detected = detect_age_ppt_category(pptx_path)
        if detected is None:
            continue
        order, _label = detected
        resolved = pptx_path.resolve()
        if resolved not in seen:
            seen.add(resolved)
            matched.append((order, pptx_path.name.lower(), pptx_path))

    return [item[2] for item in sorted(matched, key=lambda item: (item[0], item[1]))]


def run_age_based_notes_process_for_one_ppt(pptx_path, output_path, notes_box_name, as_of_date_value, risk_free_rate, mibor_date_value, launch_date_map=None, progress_cb=None):
    def log(message: str) -> None:
        if progress_cb:
            progress_cb(message)

    pptx_path = Path(pptx_path)
    output_path = Path(output_path)
    if not pptx_path.exists():
        raise FileNotFoundError(f"PPTX not found: {pptx_path}")

    launch_date_map = launch_date_map or {}
    prs = Presentation(str(pptx_path))
    total_slides = len(prs.slides)
    updated_slides = 0
    skipped_slides = 0
    created_notes_boxes = 0

    log(f"[AgeBased] Processing PPT: {pptx_path.name}")

    for slide_idx, slide in enumerate(prs.slides, start=1):
        notes_shape, notes_shape_status = find_or_create_textbox_below_sector_allocation(slide, notes_box_name, progress_cb=log)

        if notes_shape is None:
            log(f"[AgeBased] {pptx_path.name} | Slide {slide_idx}: SKIP - NotesBox '{notes_box_name}' not found and could not be created below '{SECTOR_ALLOCATION_OBJECT_NAME}'.")
            skipped_slides += 1
            continue

        if notes_shape_status == "created":
            created_notes_boxes += 1
            log(f"[AgeBased] {pptx_path.name} | Slide {slide_idx}: NotesBox was missing. Created dynamically below '{SECTOR_ALLOCATION_OBJECT_NAME}'.")

        fund_name = detect_fund_name_from_slide(slide)
        launch_date = find_launch_date_in_slide(slide)
        source = "PPT"
        if launch_date is None:
            launch_date, score, matched_name = find_launch_date_for_fund(fund_name, launch_date_map)
            source = f"Excel match '{matched_name}' score={score:.2f}" if launch_date else "Not found"
        if launch_date is None:
            log(f"[AgeBased] {pptx_path.name} | Slide {slide_idx}: SKIP - launch date not found. Fund detected: '{fund_name}'.")
            skipped_slides += 1
            continue

        notes, age_years = build_notes_by_age(launch_date, as_of_date_value, risk_free_rate, mibor_date_value)
        log(f"[AgeBased] {pptx_path.name} | Slide {slide_idx}: Fund='{fund_name or 'Not detected'}'")
        log(f"  Launch Date: {launch_date.strftime('%d-%b-%Y')} | Source: {source} | Completed years: {age_years}")

        added_count = 0
        verified_count = 0
        for note in notes:
            ok, status = append_text_to_shape(notes_shape, note)
            if ok and status == "added":
                added_count += 1
                log(f"  Added note: {note}")
            elif ok and status == "already_exists":
                verified_count += 1
                log(f"  Note already exists: {note}")
            else:
                log(f"  FAILED to add note: {note}")

        if added_count or verified_count:
            updated_slides += 1
        else:
            skipped_slides += 1
        log(f"[AgeBased] {pptx_path.name} slide progress: {int((slide_idx / max(1, total_slides)) * 100)}%")

    output_path.parent.mkdir(parents=True, exist_ok=True)
    prs.save(str(output_path))
    log(f"[AgeBased] Saved output PPT: {output_path}")

    return {
        "input_path": pptx_path,
        "output_path": output_path,
        "updated_slides": updated_slides,
        "skipped_slides": skipped_slides,
        "created_notes_boxes": created_notes_boxes,
    }


def run_age_based_notes_batch_process(source_folder, output_folder, notes_box_name, as_of_date_value, risk_free_rate, mibor_date_value, excel_path=None, excel_sheet_name=None, progress_cb=None):
    def log(message: str) -> None:
        if progress_cb:
            progress_cb(message)

    source_folder = Path(source_folder)
    output_folder = Path(output_folder)
    if not source_folder.exists() or not source_folder.is_dir():
        raise FileNotFoundError(f"Source PPT folder not found: {source_folder}")

    pptx_files = detect_age_based_pptx_files(source_folder)
    if not pptx_files:
        raise ValueError("No matching PPTX files found in source folder. Expected file names containing Equity, Debt, Hybrid, Equity Passive, or Debt Passive. The word 'updated' is optional.")

    output_folder.mkdir(parents=True, exist_ok=True)
    launch_date_map = load_launch_dates_from_excel(excel_path, excel_sheet_name, log) if excel_path else {}

    log("[AgeBased] Progress: 0%")
    log(f"[AgeBased] Source folder: {source_folder}")
    log(f"[AgeBased] Output folder: {output_folder}")
    log(f"[AgeBased] Detected PPT files: {len(pptx_files)}")
    for path in pptx_files:
        detected = detect_age_ppt_category(path)
        label = detected[1] if detected else "Unknown"
        log(f"  - {path.name} [{label}]")

    results = []
    total_files = len(pptx_files)
    for file_index, pptx_path in enumerate(pptx_files, start=1):
        output_path = output_folder / f"{pptx_path.stem}_age_notes_updated.pptx"
        if pptx_path.resolve() == output_path.resolve():
            output_path = output_folder / f"{pptx_path.stem}_age_notes_updated_copy.pptx"

        log("-" * 80)
        log(f"[AgeBased] File {file_index}/{total_files}: {pptx_path.name}")
        result = run_age_based_notes_process_for_one_ppt(
            pptx_path=pptx_path,
            output_path=output_path,
            notes_box_name=notes_box_name,
            as_of_date_value=as_of_date_value,
            risk_free_rate=risk_free_rate,
            mibor_date_value=mibor_date_value,
            launch_date_map=launch_date_map,
            progress_cb=log,
        )
        results.append(result)
        log(f"[AgeBased] Progress: {int((file_index / max(1, total_files)) * 100)}%")

    total_updated = sum(item["updated_slides"] for item in results)
    total_skipped = sum(item["skipped_slides"] for item in results)
    total_created = sum(item["created_notes_boxes"] for item in results)

    log("[AgeBased] Progress: 100%")
    log(f"[AgeBased] Batch complete. Files processed: {len(results)}")

    return {
        "output_folder": output_folder,
        "files_processed": len(results),
        "detected_files": pptx_files,
        "results": results,
        "updated_slides": total_updated,
        "skipped_slides": total_skipped,
        "created_notes_boxes": total_created,
    }



def iterate_shapes(shapes):
    for shape in shapes:
        yield shape
        if hasattr(shape, "shapes"):
            yield from iterate_shapes(shape.shapes)


def iter_shapes(shapes):
    for shape in shapes:
        yield shape
        if shape.shape_type == MSO_SHAPE_TYPE.GROUP:
            yield from iter_shapes(shape.shapes)


def shape_has_text(shape) -> bool:
    return getattr(shape, "has_text_frame", False)


def get_shape_name(shape) -> str:
    try:
        return shape.name or ""
    except Exception:
        return ""


def get_shape_text(shape) -> str:
    if shape_has_text(shape):
        try:
            return shape.text_frame.text or ""
        except Exception:
            return ""
    if getattr(shape, "has_table", False):
        parts = []
        try:
            for row in shape.table.rows:
                for cell in row.cells:
                    if cell.text:
                        parts.append(cell.text)
        except Exception:
            pass
        return "\n".join(parts)
    return ""


def get_slide_text(slide) -> str:
    parts = []
    for shape in iter_shapes(slide.shapes):
        text = get_shape_text(shape)
        if text:
            parts.append(text)
    return "\n".join(parts)


def find_shape_by_name(slide, target_name):
    target = normalize_text_for_match(target_name)
    for shape in iter_shapes(slide.shapes):
        if normalize_text_for_match(get_shape_name(shape)) == target:
            return shape
    return None


def find_or_create_textbox_below_sector_allocation(slide, target_shape_name: str, progress_cb=None):
    existing_shape = find_shape_by_name(slide, target_shape_name)
    if existing_shape is not None:
        return existing_shape, "existing"

    sector_shape = find_shape_by_name(slide, SECTOR_ALLOCATION_OBJECT_NAME)
    if sector_shape is None:
        if progress_cb:
            progress_cb(
                f"Target textbox '{target_shape_name}' not found and "
                f"'{SECTOR_ALLOCATION_OBJECT_NAME}' object also not found. Cannot create textbox."
            )
        return None, "sector_allocation_missing"

    left = sector_shape.left
    top = sector_shape.top + sector_shape.height + Cm(TEXTBOX_GAP_BELOW_SECTOR_CM)
    width = sector_shape.width
    height = Cm(DYNAMIC_NOTES_BOX_HEIGHT_CM)

    new_shape = slide.shapes.add_textbox(left, top, width, height)
    new_shape.name = target_shape_name
    text_frame = new_shape.text_frame
    text_frame.clear()
    text_frame.word_wrap = True
    text_frame.margin_left = Cm(0.05)
    text_frame.margin_right = Cm(0.05)
    text_frame.margin_top = Cm(0.03)
    text_frame.margin_bottom = Cm(0.03)

    if progress_cb:
        progress_cb(
            f"Created textbox '{target_shape_name}' below "
            f"'{SECTOR_ALLOCATION_OBJECT_NAME}' with {TEXTBOX_GAP_BELOW_SECTOR_CM} cm gap."
        )
    return new_shape, "created"



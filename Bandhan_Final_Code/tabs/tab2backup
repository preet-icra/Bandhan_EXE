def exit_normalize_text(value):
    if value is None:
        return ""

    value = str(value)
    value = html.unescape(value)
    value = value.replace("\r\n", "\n")
    value = value.replace("\r", "\n")
    value = value.replace("\xa0", " ")
    value = re.sub(r"[ \t]+", " ", value)

    return value.strip()


def exit_is_nil_or_na(value):
    """
    If Exit Load value is Nil / NA / N.A. / Not Applicable,
    keep original text as it is.
    """
    value = exit_normalize_text(value).lower()
    value = value.replace(".", "")
    value = value.replace(":", "")
    value = value.strip()

    nil_values = {
        "nil",
        "na",
        "n a",
        "not applicable",
        "notapplicable",
    }

    return value in nil_values


def exit_format_exit_load_text(original_text):
    """
    Converts:
        Exit Load: ► 0.25% if redeemed...
        ► Nil if redeemed...

    Into:
        Exit Load:
        ► 0.25% if redeemed...
        ► Nil if redeemed...

    Keeps as-is if:
        Exit Load: Nil
        Exit Load: NA
        Exit Load: N.A.
        Exit Load: Not Applicable
    """

    text = exit_normalize_text(original_text)

    if "exit load" not in text.lower():
        return text, False, "Exit Load not found"

    pattern = re.compile(r"(Exit\s*Load\s*:)(.*)", re.IGNORECASE | re.DOTALL)
    match = pattern.search(text)

    if not match:
        return text, False, "Exit Load pattern not matched"

    label = match.group(1).strip()
    after_label = match.group(2)

    after_label_clean = after_label.strip()

    if after_label_clean == "":
        return text, False, "No text after Exit Load"

    # Already formatted, Exit Load: already followed by next line
    if after_label.startswith("\n"):
        return text, False, "Already formatted"

    first_line_after_label = after_label_clean.split("\n")[0].strip()

    # Keep Nil / NA as-is
    if exit_is_nil_or_na(first_line_after_label):
        return text, False, "Nil/NA found, kept as-is"

    new_text = f"{label}\n{after_label_clean}"

    return new_text, True, "Exit Load points moved to next line"



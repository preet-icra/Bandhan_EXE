    targets = []
    if hasattr(self, "section_tabs"):
        current_index = self.section_tabs.currentIndex()
        if current_index == 0 and hasattr(self, "age_log_box"):
            targets.append(self.age_log_box)
        elif current_index == 1 and hasattr(self, "manual_log_box"):
            targets.append(self.manual_log_box)

    if not targets:
        if hasattr(self, "age_log_box"):
            targets.append(self.age_log_box)

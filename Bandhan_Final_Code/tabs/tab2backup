gold_TARGET_FUNDS = [
    "Bandhan Gold ETF",
    "Bandhan Silver ETF"
]

gold_OUTPUT_FILE_NAME = "Updated_Bandhan_Gold_and_Silver_ETF_Portfolio.pptx"
gold_NAV_TOLERANCE = 0.15

gold_PPT_PASTE_FONT_NAME = "Ubuntu"
gold_PPT_PASTE_FONT_SIZE = 6


# =========================================================
# TEXT HELPERS
# =========================================================
def gold_normalize_text(value):
    if value is None:
        return ""

    value = str(value)
    value = html.unescape(value)
    value = value.replace("\xa0", " ")
    value = value.replace("\n", " ")
    value = value.replace("\r", " ")
    value = re.sub(r"\s+", " ", value)

    return value.strip()


def gold_normalize_header(value):
    value = gold_normalize_text(value).lower()
    value = value.replace("%", "percent")
    value = value.replace("/", " ")
    value = value.replace("-", " ")
    value = value.replace("_", " ")
    value = re.sub(r"[^a-z0-9]+", " ", value)
    value = re.sub(r"\s+", " ", value)

    return value.strip()


def gold_parse_number(value):
    try:
        if value is None:
            return None

        text = gold_normalize_text(value)
        text = text.replace(",", "")
        text = text.replace("%", "")
        text = text.strip()

        if text == "":
            return None

        return float(text)

    except Exception:
        return None


def gold_clean_ppt_nav(value):
    number = gold_parse_number(value)

    if number is None:
        return None

    return round(number, 4)


def gold_excel_net_asset_candidates(value):
    if value is None:
        return []

    raw_text = gold_normalize_text(value)
    has_percent = "%" in raw_text

    number = gold_parse_number(value)

    if number is None:
        return []

    candidates = set()

    if has_percent:
        candidates.add(round(number, 4))
    else:
        candidates.add(round(number, 4))

        if abs(number) <= 1:
            candidates.add(round(number * 100, 4))

    return list(candidates)


def gold_get_best_difference(ppt_nav, excel_value):
    candidates = gold_excel_net_asset_candidates(excel_value)

    if ppt_nav is None or not candidates:
        return None

    return min(abs(ppt_nav - candidate) for candidate in candidates)


def gold_fund_matches(excel_fund_name, target_fund):
    excel_fund_name = gold_normalize_text(excel_fund_name).lower()
    target_fund = gold_normalize_text(target_fund).lower()

    if target_fund in excel_fund_name:
        return True

    if "gold" in target_fund:
        return "gold" in excel_fund_name and "etf" in excel_fund_name

    if "silver" in target_fund:
        return "silver" in excel_fund_name and "etf" in excel_fund_name

    return False


def gold_detect_fund_from_text(value):
    for fund in gold_TARGET_FUNDS:
        if gold_fund_matches(value, fund):
            return fund

    return None


def gold_is_total_or_cash(value):
    value = gold_normalize_text(value).lower()

    skip_words = [
        "total",
        "grand total",
        "net cash",
        "cash equivalent",
        "cash & other",
        "cash and other",
        "receivable",
        "payable",
        "margin",
        "collateral",
        "clearing"
    ]

    return any(word in value for word in skip_words)


# =========================================================
# PPT HELPERS
# =========================================================
def gold_iter_all_shapes(shapes):
    for shape in shapes:
        yield shape

        if hasattr(shape, "shapes"):
            for child_shape in gold_iter_all_shapes(shape.shapes):
                yield child_shape


def gold_get_shape_text(shape):
    try:
        if hasattr(shape, "text"):
            return gold_normalize_text(shape.text)
    except Exception:
        pass

    try:
        if shape.has_text_frame:
            return gold_normalize_text(shape.text_frame.text)
    except Exception:
        pass

    return ""


def gold_set_cell_text(cell, text):
    """
    Paste text into PPT cell with:
    Font Name: Ubuntu
    Font Size: 6
    """
    clean_text = gold_normalize_text(text)

    text_frame = cell.text_frame
    text_frame.clear()

    paragraph = text_frame.paragraphs[0]

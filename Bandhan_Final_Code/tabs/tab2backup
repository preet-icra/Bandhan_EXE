    p.alignment = PP_ALIGN.CENTER  # ✅ CENTER ALIGN


# ✅ SAFE ROW ADD (WILL TRY, MAY FAIL DEPENDING ON PPT)
def sector_safe_add_row(table):
    try:
        tbl = table._tbl
        if len(tbl.tr_lst) == 0:
            return False

        new_tr = copy.deepcopy(tbl.tr_lst[-1])
        tbl.append(new_tr)
        return True
    except:
        return False


class sector_SectorAllocationApp(QWidget):
    def __init__(self):
        super().__init__()

        self.setWindowTitle("Sector Allocation Automation")
        self.resize(900, 500)

        layout = QHBoxLayout()


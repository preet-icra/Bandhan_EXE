# ✅ FORMAT FUNCTIONS
def sector_format_cell_left(cell, text):
    tf = cell.text_frame
    tf.clear()

    p = tf.paragraphs[0]
    run = p.add_run()
    run.text = str(text)

    run.font.size = Pt(6)
    run.font.name = "Ubuntu"

        self.excel_path = self.excel_edit.text().strip()
        self.ppt_path = self.ppt_edit.text().strip()
        output_folder = self.output_folder_edit.text().strip()

        if not self.excel_path:
            QMessageBox.warning(self, "Missing Excel", "Please select Excel file.")
            return
        if not self.ppt_path:
            QMessageBox.warning(self, "Missing PPT", "Please select PPT file.")
            return
        if not output_folder:
            QMessageBox.warning(self, "Missing Output Folder", "Please select output folder.")
            return
        if not Path(self.excel_path).exists():
            QMessageBox.warning(self, "Invalid Excel", "Selected Excel file does not exist.")
            return
        if not Path(self.ppt_path).exists():
            QMessageBox.warning(self, "Invalid PPT", "Selected PPT file does not exist.")
            return

        try:
            if self.external_log_box is not None:
                self.external_log_box.clear()
            self.progress.setValue(0)
            self.status_label.setText("Running...")
            self.btn_run.setEnabled(False)
            self.log_msg("Reading Excel...")

            df = pd.read_excel(self.excel_path, engine="openpyxl")
            self.progress.setValue(10)

            df.columns = df.columns.str.strip()
            df.rename(columns={
                "AMFI_Industry": "Industry",
                "% to Net Assets": "Weight",
            }, inplace=True)

            df["Fund Name"] = df["Fund Name"].str.strip().str.lower()

            prs = Presentation(self.ppt_path)
            self.progress.setValue(25)

            total_funds = len(self.mapping)
            processed_funds = 0

            for fund, benchmark in self.mapping.items():
                self.log_msg(f"Processing: {fund}")

                fund_df = df[df["Fund Name"] == fund]
                bench_df = df[df["Fund Name"] == benchmark]

                if fund_df.empty:
                    self.log_msg(f"No data for fund: {fund}")
                    processed_funds += 1
                    continue

                if bench_df.empty:
                    self.log_msg(f"No data for benchmark: {benchmark}")
                    processed_funds += 1
                    continue

                fund_grp = fund_df.groupby("Industry")["Weight"].sum()
                bench_grp = bench_df.groupby("Industry")["Weight"].sum()

                combined = pd.DataFrame({
                    "Weight in Fund": fund_grp,
                    "Weight in Index": bench_grp,
                }).fillna(0)

                combined["Overweight/underweight"] = combined["Weight in Fund"] - combined["Weight in Index"]
                combined = combined.reset_index()
                combined.rename(columns={"Industry": "Sector"}, inplace=True)
                combined = combined.sort_values(by="Weight in Fund", ascending=False)

                slide_found = False

                for slide in prs.slides:
                    for shape in slide.shapes:
                        if shape.name == "Fund Name" and shape.has_text_frame and shape.text_frame.text.strip().lower() == fund:
                            slide_found = True
                            for s in slide.shapes:
                                if s.has_table and s.name == "SectorAllocation":
                                    table = s.table
                                    existing_rows = len(table.rows) - 1
                                    required_rows = len(combined)

                                    if required_rows > existing_rows:
                                        for _ in range(required_rows - existing_rows):
                                            if not sector_safe_add_row(table):
                                                break

                                    total_available = len(table.rows) - 1

                                    for i in range(min(len(combined), total_available)):
                                        row = combined.iloc[i]
                                        sector_format_cell_left(table.cell(i + 1, 0), row["Sector"])
                                        sector_format_cell_center(table.cell(i + 1, 1), f"{row['Weight in Fund']:.1f}%")
                                        sector_format_cell_center(table.cell(i + 1, 2), f"{row['Weight in Index']:.1f}%")
                                        sector_format_cell_center(table.cell(i + 1, 3), f"{row['Overweight/underweight']:.1f}%")

                                    for i in range(len(combined), total_available):
                                        sector_format_cell_left(table.cell(i + 1, 0), "")
                                        sector_format_cell_center(table.cell(i + 1, 1), "")
                                        sector_format_cell_center(table.cell(i + 1, 2), "")
                                        sector_format_cell_center(table.cell(i + 1, 3), "")

                                    self.log_msg(f"Table updated for {fund}")

                if not slide_found:
                    self.log_msg(f"Slide NOT found for fund: {fund}")

                processed_funds += 1
                self.progress.setValue(25 + int((processed_funds / max(total_funds, 1)) * 60))

            output_folder_path = Path(output_folder)
            output_folder_path.mkdir(parents=True, exist_ok=True)
            output_file = output_folder_path / f"{Path(self.ppt_path).stem}_sector_allocation_updated.pptx"
            prs.save(str(output_file))

            self.progress.setValue(100)
            self.log_msg(f"Saved: {output_file}")
            self.status_label.setText("Completed")
            QMessageBox.information(self, "Done", f"Sector Allocation updated successfully.\n\nSaved file:\n{output_file}")

        except Exception as e:
            self.log_msg(f"Error: {str(e)}")
            self.status_label.setText("Failed")
            QMessageBox.critical(self, "Failed", str(e))
        finally:
            self.btn_run.setEnabled(True)



class WorkerSignals(QObject):
    started = pyqtSignal()
    finished = pyqtSignal(object)
    error = pyqtSignal(str)
    progress = pyqtSignal(str)


class FunctionWorker(QRunnable):
    def __init__(self, func: Callable[..., Any], *args: Any, **kwargs: Any) -> None:
        super().__init__()
        self.func = func
        self.args = args
        self.kwargs = kwargs
        self.signals = WorkerSignals()

    @pyqtSlot()
    def run(self) -> None:
        self.signals.started.emit()
        try:
            if hasattr(self.func, "__code__") and "progress_cb" in self.func.__code__.co_varnames and "progress_cb" not in self.kwargs:
                self.kwargs["progress_cb"] = self.signals.progress.emit
            result = self.func(*self.args, **self.kwargs)
        except Exception:
            self.signals.error.emit(traceback.format_exc())
        else:
            self.signals.finished.emit(result)


# =========================================================
# Text helpers
# =========================================================
def normalize_text(value) -> str:
    if value is None:
        return ""
    if pd is not None:
        try:
            if pd.isna(value):
                return ""
        except (TypeError, ValueError):
            pass
    return str(value).strip()


def normalize_text_for_match(value) -> str:
    text = str(value or "").replace("&amp;amp;", "&").lower().replace("&amp;", "and")
    text = re.sub(r"[^a-z0-9]+", " ", text)
    return re.sub(r"\s+", " ", text).strip()


def normalize_file_key(value) -> str:
    return re.sub(r"[^a-z0-9]+", "", str(value or "").lower())


def decode_note_html(value) -> str:
    text = normalize_text(value)
    previous = None
    while previous != text:
        previous = text
        text = html.unescape(text)
    return text


def remove_only_known_html_tags(text) -> str:
    text = decode_note_html(text)
    for tag in KNOWN_HTML_TAGS:
        text = re.sub(rf"&amp;lt;/?{tag}\b[^&amp;gt;]*&amp;gt;", " ", text, flags=re.IGNORECASE)
        text = re.sub(rf"&lt;/?{tag}\b[^&gt;]*&gt;", " ", text, flags=re.IGNORECASE)
    return text


def clean_match_text(value) -> str:
    text = remove_only_known_html_tags(value).lower()
    text = text.replace("&amp;amp;", "and").replace("&amp;", "and")
    text = text.replace("&amp;lt;", " ").replace("&amp;gt;", " ")
    text = text.replace("&lt;", " ").replace("&gt;", " ")
    text = re.sub(r"[^a-z0-9]+", " ", text)
    return re.sub(r"\s+", " ", text).strip()


def compact_match_text(value) -> str:
    return clean_match_text(value).replace(" ", "")


def text_contains_value(haystack, needle) -> bool:
    cleaned_needle = clean_match_text(needle)
    if not cleaned_needle:
        return True
    cleaned_haystack = clean_match_text(haystack)
    return cleaned_needle in cleaned_haystack or compact_match_text(needle) in compact_match_text(haystack)


def clean_text(value) -> str:
    text = str(value or "").replace("&amp;amp;", "&")
    text = re.sub(r"[£¥§ß¢$]+", "", text)
    return re.sub(r"\s+", " ", text).strip()


# =========================================================
# HTML note formatter for Section 2 Manual
# =========================================================
class NoteHTMLParser(HTMLParser):
    def __init__(self):
        super().__init__(convert_charrefs=False)
        self.stack: list[str] = []
        self.segments: list[tuple[str, dict[str, bool]]] = []

    def current_style(self) -> dict[str, bool]:
        return {
            "sup": "sup" in self.stack,
            "sub": "sub" in self.stack,
            "bold": "b" in self.stack or "strong" in self.stack,
            "italic": "i" in self.stack or "em" in self.stack,
            "underline": "u" in self.stack,
        }

    def handle_starttag(self, tag, attrs):
        tag_lower = tag.lower()
        if tag_lower in ["sup", "sub", "b", "strong", "i", "em", "u"]:
            self.stack.append(tag_lower)
        elif tag_lower in ["br", "p", "div"]:
            self.handle_data(" ")
        else:
            attr_text = "".join(f' {name}="{value}"' for name, value in attrs)
            self.handle_data(f"<{tag}{attr_text}>")

    def handle_endtag(self, tag):
        tag_lower = tag.lower()
        if tag_lower in ["sup", "sub", "b", "strong", "i", "em", "u"]:
            for index in range(len(self.stack) - 1, -1, -1):
                if self.stack[index] == tag_lower:
                    del self.stack[index]
                    break
        elif tag_lower not in ["br", "p", "div"]:
            self.handle_data(f"</{tag}>")

    def handle_data(self, data):
        if data:
            self.segments.append((html.unescape(data), self.current_style().copy()))

    def handle_entityref(self, name):
        self.handle_data(html.unescape(f"&{name};"))

    def handle_charref(self, name):
        self.handle_data(html.unescape(f"&#{name};"))


def parse_note_html(value) -> list[tuple[str, dict[str, bool]]]:
    parser = NoteHTMLParser()
    parser.feed(decode_note_html(value))
    parser.close()
    return parser.segments


def apply_run_note_style(run, style: dict[str, bool]) -> None:
    run.font.name = NOTE_FONT_NAME
    run.font.size = Pt(NOTE_FONT_SIZE_PT)
    run.font.bold = bool(style.get("bold"))
    run.font.italic = bool(style.get("italic"))
    run.font.underline = bool(style.get("underline"))
    if style.get("sup") or style.get("sub"):
        r_pr = run._r.get_or_add_rPr()
        r_pr.set("baseline", "30000" if style.get("sup") else "-25000")


def set_note_shape_html_text(shape, note_html_text) -> None:
    if not getattr(shape, "has_text_frame", False):
        return
    text_frame = shape.text_frame
    text_frame.clear()
    paragraph = text_frame.paragraphs[0]
    for text, style in parse_note_html(note_html_text):
        if not text:
            continue
        run = paragraph.add_run()
        run.text = text
        apply_run_note_style(run, style)



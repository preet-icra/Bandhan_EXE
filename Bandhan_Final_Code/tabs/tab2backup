def canonical_note_key(value):
    if value is None:
        return ""
    raw = str(value).replace("&amp;amp;", "&").strip()
    marker = ""
    for char in raw:
        if char.isspace():
            continue
        if char in {"*", "^", "#", "@"}:
            marker = char
        break
    return f"{marker}|{normalize_text_for_match(raw)}"


def get_text_frame_paragraph_texts(shape):
    texts = []
    if not getattr(shape, "has_text_frame", False):
        return texts
    try:
        for paragraph in shape.text_frame.paragraphs:
            text = "".join(run.text for run in paragraph.runs).strip()
            if not text:
                text = getattr(paragraph, "text", "").strip()
            if text:
                texts.append(text)
    except Exception:
        texts = [line.strip() for line in (shape.text_frame.text or "").splitlines() if line.strip()]
    return texts


def note_already_exists(shape, note_text):
    required_key = canonical_note_key(note_text)
    return any(canonical_note_key(p) == required_key for p in get_text_frame_paragraph_texts(shape))


def normalize_for_match(value):
    remove_words = {"bandhan", "mutual", "fund", "regular", "direct", "growth", "plan", "option", "idcw", "dividend", "scheme", "the", "and"}
    return " ".join(word for word in normalize_text_for_match(value).split() if word not in remove_words)


def similarity(a, b):
    a = normalize_for_match(a)
    b = normalize_for_match(b)
    return 0.0 if not a or not b else SequenceMatcher(None, a, b).ratio()


def ordinal_day(day):
    suffix = "th" if 10 <= day % 100 <= 20 else {1: "st", 2: "nd", 3: "rd"}.get(day % 10, "th")
    return f"{day}{suffix}"


def format_date_with_ordinal(dt):
    return f"{ordinal_day(dt.day)} {dt.strftime('%B')} {dt.year}"


def parse_date(value):
    if value is None:
        return None
    if isinstance(value, datetime):
        return value.date()
    if isinstance(value, date):
        return value
    text = str(value).strip().replace("–", "-").replace("—", "-")
    if not text:
        return None
    text = re.sub(r"(\d{1,2})(st|nd|rd|th)", r"\1", text, flags=re.IGNORECASE)
    text = re.sub(r"\s+", " ", text)
    formats = [
        "%d-%m-%Y", "%d/%m/%Y", "%d.%m.%Y", "%d-%b-%Y", "%d/%b/%Y", "%d %b %Y",
        "%d-%B-%Y", "%d/%B/%Y", "%d %B %Y", "%Y-%m-%d", "%d-%m-%y", "%d/%m/%y",
        "%d-%b-%y", "%d %b %y"
    ]
    for fmt in formats:
        try:
            return datetime.strptime(text, fmt).date()
        except ValueError:
            pass
    for pattern in [r"\b\d{1,2}[-/]\d{1,2}[-/]\d{2,4}\b", r"\b\d{1,2}[-\s][A-Za-z]{3,9}[-\s]\d{2,4}\b", r"\b\d{4}-\d{1,2}-\d{1,2}\b"]:
        match = re.search(pattern, text)
        if match:
            parsed = parse_date(match.group(0))
            if parsed:
                return parsed
    return None


def completed_years(launch_date, as_of_date):
    years = as_of_date.year - launch_date.year
    if (as_of_date.month, as_of_date.day) < (launch_date.month, launch_date.day):
        years -= 1
    return years



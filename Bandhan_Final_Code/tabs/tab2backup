        self.output_folder = Path(output_folder)

    def run(self):
        try:
            if not self.pptx_files:
                self.finished_signal.emit(False, "No PPTX files found in selected source folder.")
                return
            self.output_folder.mkdir(parents=True, exist_ok=True)
            total = len(self.pptx_files)
            success_count = 0
            failed_count = 0
            for index, pptx_path in enumerate(self.pptx_files, start=1):
                self.log_signal.emit("")
                self.log_signal.emit("=" * 70)
                self.log_signal.emit(f"[{index}/{total}] Processing: {pptx_path.name}")
                self.log_signal.emit("=" * 70)
                def local_progress(value):
                    overall = int(((index - 1) / total) * 100 + (value / max(total, 1)))
                    self.progress_signal.emit(max(0, min(100, overall)))
                ok, message = exit_process_ppt(str(pptx_path), str(self.output_folder), progress_callback=local_progress, log_callback=self.log_signal.emit)
                fixed_output = self.output_folder / exit_OUTPUT_FILE_NAME
                renamed_output = self.output_folder / f"{pptx_path.stem}_exitload_updated.pptx"
                if ok:
                    if fixed_output.exists():
                        if renamed_output.exists():
                            renamed_output.unlink()
                        fixed_output.rename(renamed_output)
                        self.log_signal.emit(f"Saved renamed file: {renamed_output}")
                    success_count += 1
                else:
                    failed_count += 1
                    self.log_signal.emit(f"FAILED: {message}")
                self.progress_signal.emit(int((index / total) * 100))
            summary = f"Exit Load batch completed.\n\nTotal PPTX files: {total}\nSuccessful: {success_count}\nFailed: {failed_count}\n\nOutput folder:\n{self.output_folder}"
            self.finished_signal.emit(success_count > 0, summary)
        except Exception:
            error = traceback.format_exc()
            self.log_signal.emit(error)
            self.finished_signal.emit(False, error)



# =========================================================
# EXCEL COLUMN DETECTION
# =========================================================
def gold_find_excel_columns(ws, log_callback=None):
    def log(message):
        if log_callback:
            log_callback(str(message))

    max_scan_rows = min(ws.max_row or 30, 30)
    max_col = ws.max_column or 100

    for row_no in range(1, max_scan_rows + 1):
        headers = []

        for col in range(1, max_col + 1):
            raw_value = ws.cell(row=row_no, column=col).value

            headers.append({
                "index": col - 1,
                "number": col,
                "raw": gold_normalize_text(raw_value),
                "norm": gold_normalize_header(raw_value)
            })

        fund_col = None
        security_col = None
        net_assets_col = None

        for header in headers:
            norm = header["norm"]

            if fund_col is None:
                if norm in ["fund name", "scheme name", "portfolio name"]:
                    fund_col = header["index"]
                elif "fund name" in norm or "scheme name" in norm or "portfolio name" in norm:
                    fund_col = header["index"]

            if security_col is None:
                if norm in [
                    "security name",
                    "securities name",
                    "name of security",
                    "name of instrument",
                    "instrument name"
                ]:
                    security_col = header["index"]
                elif "security name" in norm:
                    security_col = header["index"]

            if net_assets_col is None:
                if norm in [
                    "percent to net assets",
                    "percent to net asset",
                    "to net assets",
                    "percent of net assets",
                    "percentage to net assets"
                ]:
                    net_assets_col = header["index"]
                elif "to net assets" in norm:
                    net_assets_col = header["index"]
                elif "net assets" in norm and "percent" in norm:
                    net_assets_col = header["index"]

        if fund_col is not None and security_col is not None and net_assets_col is not None:
            log("Excel columns detected successfully.")
            log(f"Header row number: {row_no}")
            log(f"Fund Name column: {fund_col + 1}")
            log(f"Security Name column: {security_col + 1}")
            log(f"% to Net Assets column: {net_assets_col + 1}")

            return {
                "header_row": row_no,
                "fund_col": fund_col,
                "security_col": security_col,
                "net_assets_col": net_assets_col
            }

    log("WARNING: Could not detect Excel columns dynamically.")
    log("Using fallback: Fund Name=C, Security Name=T, % to Net Assets=W")

    return {
        "header_row": 1,
        "fund_col": 2,
        "security_col": 19,
        "net_assets_col": 22
    }


# =========================================================
# BUILD EXCEL ROWS BY FUND
# =========================================================
def gold_build_excel_rows_by_fund(ws, excel_cols, log_callback=None):
    def log(message):
        if log_callback:
            log_callback(str(message))

    rows_by_fund = defaultdict(list)

    header_row = excel_cols["header_row"]
    fund_col = excel_cols["fund_col"]
    security_col = excel_cols["security_col"]
    net_assets_col = excel_cols["net_assets_col"]

    max_needed_col = max(fund_col, security_col, net_assets_col) + 1

    log("Building Excel rows by Fund Name...")
    log("Searching Excel Fund Name column for Bandhan Gold ETF / Bandhan Silver ETF.")
    log("Paste value will be Excel Security Name.")
    log(f"PPT pasted font: {gold_PPT_PASTE_FONT_NAME}, size {gold_PPT_PASTE_FONT_SIZE}")

    scanned = 0
    matched = 0
    skipped_samples = 0

    for excel_row_no, row in enumerate(
        ws.iter_rows(
            min_row=header_row + 1,
            max_col=max_needed_col,
            values_only=True
        ),
        start=header_row + 1
    ):
        scanned += 1

        fund_name = gold_normalize_text(row[fund_col]) if fund_col < len(row) else ""
        security_name = gold_normalize_text(row[security_col]) if security_col < len(row) else ""
        net_assets_value = row[net_assets_col] if net_assets_col < len(row) else None

        if not fund_name:
            continue

        matched_fund = gold_detect_fund_from_text(fund_name)

        if matched_fund not in gold_TARGET_FUNDS:
            if skipped_samples < 5:
                skipped_samples += 1
                log(
                    f"Skipped sample row {excel_row_no} | "
                    f"Fund Name: {fund_name} | "
                    f"Security Name: {security_name} | "
                    f"% to Net Assets: {net_assets_value}"
                )
            continue

        if not security_name:
            continue

        if gold_normalize_header(security_name) in [
            "security name",
            "securities name",
            "name of security",
            "name of instrument",
            "instrument name"
        ]:
            continue

        if gold_is_total_or_cash(security_name):
            continue

        if not gold_excel_net_asset_candidates(net_assets_value):
            continue

        rows_by_fund[matched_fund].append({
            "excel_row": excel_row_no,
            "fund_name": fund_name,
            "security_name": security_name,
            "net_assets_value": net_assets_value,
            "used": False
        })

        matched += 1

    log(f"Excel rows scanned: {scanned}")
    log(f"Relevant Excel rows found: {matched}")

    for fund in gold_TARGET_FUNDS:
        log(f"{fund}: Matching Excel rows found = {len(rows_by_fund[fund])}")

        for item in rows_by_fund[fund][:10]:
            log(
                f"Sample {fund} | Excel row {item['excel_row']} | "
                f"Fund Name: {item['fund_name']} | "
                f"Security Name: {item['security_name']} | "
                f"% to Net Assets: {item['net_assets_value']} | "
                f"Candidates: {gold_excel_net_asset_candidates(item['net_assets_value'])}"
            )

    return rows_by_fund


# =========================================================
# FIND PPT FUND SLIDES
# =========================================================
def gold_find_target_fund_slides(prs, log_callback=None):
    def log(message):
        if log_callback:
            log_callback(str(message))

    slides_by_fund = defaultdict(list)

    log("Scanning PPT slides using object name 'Fund Name'...")

    for slide_idx, slide in enumerate(prs.slides):
        slide_no = slide_idx + 1

        for shape in gold_iter_all_shapes(slide.shapes):
            shape_name = gold_normalize_text(getattr(shape, "name", ""))

            if shape_name.lower() != "fund name":
                continue

            shape_text = gold_get_shape_text(shape)
            matched_fund = gold_detect_fund_from_text(shape_text)

            if matched_fund in gold_TARGET_FUNDS:
                slides_by_fund[matched_fund].append(slide_idx)
                log(f"Matched PPT slide {slide_no}: {matched_fund}")
                break

    for fund in gold_TARGET_FUNDS:
        if not slides_by_fund.get(fund):
            log(f"WARNING: No PPT slide found for {fund}")

    return slides_by_fund


# =========================================================
# PPT TABLE DETECTION
# =========================================================
def gold_find_ppt_header_row(table):
    for row_idx, row in enumerate(table.rows):
        headers = [
            gold_normalize_text(cell.text).lower()
            for cell in row.cells
        ]

        has_company = any(
            "company" in header or "instrument" in header
            for header in headers
        )

        has_nav = any("nav" in header for header in headers)

        if has_company and has_nav:
            return row_idx, headers

    return None, None


def gold_find_equity_table_on_slide(slide):
    for shape in gold_iter_all_shapes(slide.shapes):
        try:
            if not shape.has_table:
                continue
        except Exception:
            continue

        shape_name = gold_normalize_text(getattr(shape, "name", ""))

        if shape_name.lower() == "equityholdings":
            table = shape.table
            header_row_idx, headers = gold_find_ppt_header_row(table)

            if header_row_idx is not None:
                return table, header_row_idx, headers

    for shape in gold_iter_all_shapes(slide.shapes):
        try:
            if not shape.has_table:
                continue
        except Exception:
            continue

        table = shape.table
        header_row_idx, headers = gold_find_ppt_header_row(table)

        if header_row_idx is not None:
            return table, header_row_idx, headers

    return None, None, None


# =========================================================
# UPDATE PPT TABLE
# =========================================================
def gold_update_fund_slide(slide, slide_no, fund, excel_rows, log_callback=None):
    def log(message):
        if log_callback:
            log_callback(str(message))

    log(f"Processing PPT slide {slide_no} for {fund}")

    table, header_row_idx, headers = gold_find_equity_table_on_slide(slide)

    if table is None:
        log(f"WARNING: EquityHoldings table not found on slide {slide_no}")
        return 0, 0

    try:
        company_idx = next(
            i for i, header in enumerate(headers)
            if "company" in header or "instrument" in header
        )

        nav_idx = next(
            i for i, header in enumerate(headers)
            if "nav" in header
        )

    except Exception:
        log(f"WARNING: Required PPT columns not found on slide {slide_no}. Headers: {headers}")
        return 0, 0

    checked = 0
    updated = 0

    for row_idx in range(header_row_idx + 1, len(table.rows)):
        row = table.rows[row_idx]

        ppt_company = gold_normalize_text(row.cells[company_idx].text)
        ppt_nav_text = gold_normalize_text(row.cells[nav_idx].text)
        ppt_nav = gold_clean_ppt_nav(ppt_nav_text)

        if ppt_company == "" and ppt_nav is None:
            continue

        if gold_is_total_or_cash(ppt_company):
            continue

        if ppt_nav is None:
            continue

        checked += 1

        best_match = None
        best_diff = None

        for item in excel_rows:
            if item["used"]:
                continue

            diff = gold_get_best_difference(ppt_nav, item["net_assets_value"])

            if diff is None:
                continue

            if diff <= gold_NAV_TOLERANCE:
                if best_diff is None or diff < best_diff:
                    best_diff = diff
                    best_match = item

        if best_match:
            gold_set_cell_text(row.cells[company_idx], best_match["security_name"])

            best_match["used"] = True
            updated += 1

            log(
                f"UPDATED | {fund} | Slide {slide_no} | PPT row {row_idx} | "
                f"PPT % of NAV: {ppt_nav} | "
                f"Excel % to Net Assets: {best_match['net_assets_value']} | "
                f"Excel row: {best_match['excel_row']} | "
                f"Pasted Security Name: {best_match['security_name']} | "
                f"Font: {gold_PPT_PASTE_FONT_NAME} {gold_PPT_PASTE_FONT_SIZE}"
            )
        else:
            closest_item = None
            closest_diff = None

            for item in excel_rows:
                if item["used"]:
                    continue

                diff = gold_get_best_difference(ppt_nav, item["net_assets_value"])

                if diff is None:
                    continue

                if closest_diff is None or diff < closest_diff:
                    closest_diff = diff
                    closest_item = item

            if closest_item:
                log(
                    f"No match | {fund} | Slide {slide_no} | PPT row {row_idx} | "
                    f"PPT % of NAV: {ppt_nav} | "
                    f"Closest Excel row: {closest_item['excel_row']} | "
                    f"Excel % to Net Assets: {closest_item['net_assets_value']} | "
                    f"Diff: {round(closest_diff, 4)}"
                )
            else:
                log(
                    f"No match | {fund} | Slide {slide_no} | PPT row {row_idx} | "
                    f"PPT % of NAV: {ppt_nav}"
                )

    return checked, updated


# =========================================================
# MAIN PROCESS
# =========================================================
def gold_process_files(ppt_path, excel_path, output_folder, progress_callback=None, log_callback=None):
    def log(message):
        if log_callback:
            log_callback(str(message))

    try:
        log("Starting process for both funds...")
        log("Excel Fund Name column -> search Bandhan Gold ETF / Bandhan Silver ETF")
        log("Excel % to Net Assets column -> match with PPT % of NAV")
        log("Excel Security Name column -> paste into PPT Company/Instrument")
        log(f"PPT pasted font -> {gold_PPT_PASTE_FONT_NAME}, size {gold_PPT_PASTE_FONT_SIZE}")
        log(f"PPT File: {ppt_path}")
        log(f"Excel File: {excel_path}")
        log(f"Output Folder: {output_folder}")

        if progress_callback:
            progress_callback(5)

        log("Loading PowerPoint...")
        prs = Presentation(ppt_path)

        if progress_callback:
            progress_callback(15)

        log("Loading Excel in read-only mode...")
        wb = load_workbook(
            excel_path,
            data_only=True,
            read_only=True
        )
        ws = wb.active

        if progress_callback:
            progress_callback(25)

        log("Detecting Excel columns...")
        excel_cols = gold_find_excel_columns(ws, log_callback=log)

        if progress_callback:
            progress_callback(35)

        excel_rows_by_fund = gold_build_excel_rows_by_fund(
            ws,
            excel_cols,
            log_callback=log
        )

        wb.close()

        if progress_callback:
            progress_callback(55)

        slides_by_fund = gold_find_target_fund_slides(
            prs,
            log_callback=log
        )

        if progress_callback:
            progress_callback(65)

        total_checked = 0
        total_updated = 0
        fund_summary = []

        for fund_index, fund in enumerate(gold_TARGET_FUNDS):
            log("=" * 90)
            log(f"Processing fund: {fund}")

            slide_indexes = slides_by_fund.get(fund, [])
            excel_rows = excel_rows_by_fund.get(fund, [])

            fund_checked = 0
            fund_updated = 0

            if not slide_indexes:
                log(f"WARNING: No PPT slide found for {fund}")
                fund_summary.append(f"{fund}: PPT slide not found, Rows Updated: 0")
                continue

            if not excel_rows:
                log(f"WARNING: No matching Excel rows found for {fund}")
                fund_summary.append(f"{fund}: No matching Excel rows found, Rows Updated: 0")
                continue

            for slide_idx in slide_indexes:
                checked, updated = gold_update_fund_slide(
                    slide=prs.slides[slide_idx],
                    slide_no=slide_idx + 1,
                    fund=fund,
                    excel_rows=excel_rows,
                    log_callback=log
                )

                fund_checked += checked
                fund_updated += updated

            total_checked += fund_checked
            total_updated += fund_updated

            fund_summary.append(
                f"{fund}: Rows Checked: {fund_checked}, Rows Updated: {fund_updated}"
            )

            if progress_callback:
                progress = 65 + int(((fund_index + 1) / len(gold_TARGET_FUNDS)) * 25)
                progress_callback(progress)

        log("=" * 90)
        log("Saving updated PowerPoint...")

        os.makedirs(output_folder, exist_ok=True)
        output_path = os.path.join(output_folder, gold_OUTPUT_FILE_NAME)

        prs.save(output_path)

        if progress_callback:
            progress_callback(100)

        log("Process completed.")
        log(f"Total Rows Checked: {total_checked}")
        log(f"Total Rows Updated: {total_updated}")
        log(f"Saved file: {output_path}")

        message = (
            "Completed successfully!\n\n"
            "Fund Summary:\n"
            + "\n".join(fund_summary)
            + "\n\n"
            f"Total Rows Checked: {total_checked}\n"
            f"Total Rows Updated: {total_updated}\n\n"
            f"Saved at:\n{output_path}"
        )

        return True, message

    except Exception:
        error = traceback.format_exc()
        log("ERROR occurred:")
        log(error)
        return False, error



def exit_iter_all_shapes(shapes):
    """
    Iterates normal shapes and grouped shapes.
    """
    for shape in shapes:
        yield shape

        if hasattr(shape, "shapes"):
            for child_shape in exit_iter_all_shapes(shape.shapes):
                yield child_shape


def exit_apply_cell_text_with_font(cell, text):
    """
    Writes text into table cell with Ubuntu font size 6.
    Preserves line breaks by creating separate paragraphs.
    """

    clean_text = exit_normalize_text(text)

    text_frame = cell.text_frame
    text_frame.clear()

    lines = clean_text.split("\n")

    for index, line in enumerate(lines):
        if index == 0:
            paragraph = text_frame.paragraphs[0]
        else:
            paragraph = text_frame.add_paragraph()

        paragraph.text = ""

        run = paragraph.add_run()
        run.text = line
        run.font.name = exit_FONT_NAME
        run.font.size = Pt(exit_FONT_SIZE)

        if line.strip().lower().startswith("exit load"):
            run.font.bold = True


def exit_find_fund_features_tables(prs, log_callback=None):
    """
    Finds all PowerPoint tables where object/shape name is 'Fund Features'.
    """

    def log(message):
        if log_callback:
            log_callback(str(message))

    tables = []

    for slide_index, slide in enumerate(prs.slides):
        slide_no = slide_index + 1

        for shape in exit_iter_all_shapes(slide.shapes):
            try:
                shape_name = exit_normalize_text(shape.name)
            except Exception:
                shape_name = ""

            try:
                has_table = shape.has_table
            except Exception:
                has_table = False

            if not has_table:
                continue

            if shape_name.lower() == exit_TARGET_TABLE_NAME.lower():
                tables.append(
                    {
                        "slide_no": slide_no,
                        "shape_name": shape_name,
                        "table": shape.table,
                    }
                )

                log(f"Found '{exit_TARGET_TABLE_NAME}' table on slide {slide_no}")

    return tables


# =========================================================
# MAIN PPT PROCESS
# =========================================================
def exit_process_ppt(ppt_path, output_folder, progress_callback=None, log_callback=None):
    def log(message):
        if log_callback:
            log_callback(str(message))

    try:
        log("Starting Exit Load formatting process...")
        log(f"Input PPT: {ppt_path}")
        log(f"Output Folder: {output_folder}")
        log(f"Target table object name: {exit_TARGET_TABLE_NAME}")
        log(f"Font: {exit_FONT_NAME}, Size: {exit_FONT_SIZE}")

        if progress_callback:
            progress_callback(5)

        log("Loading PowerPoint file...")
        prs = Presentation(ppt_path)

        if progress_callback:
            progress_callback(20)

        tables = exit_find_fund_features_tables(prs, log_callback=log)

        if not tables:
            return False, "No table found with object name 'Fund Features'."

        total_tables = len(tables)
        checked_cells = 0
        updated_count = 0
        skipped_count = 0

        log(f"Total '{exit_TARGET_TABLE_NAME}' tables found: {total_tables}")

        for table_index, table_info in enumerate(tables, start=1):
            slide_no = table_info["slide_no"]
            table = table_info["table"]

            log("-" * 70)
            log(f"Processing slide {slide_no}")

            for row_index, row in enumerate(table.rows):
                for cell_index, cell in enumerate(row.cells):
                    checked_cells += 1

                    original_text = exit_normalize_text(cell.text)

                    if not original_text:
                        continue

                    if "exit load" not in original_text.lower():
                        continue

                    log(
                        f"Exit Load found | Slide {slide_no}, "
                        f"Row {row_index}, Cell {cell_index}"
                    )

                    new_text, changed, reason = exit_format_exit_load_text(original_text)

                    if changed:
                        exit_apply_cell_text_with_font(cell, new_text)
                        updated_count += 1

                        log(
                            f"UPDATED | Slide {slide_no}, Row {row_index}, "
                            f"Cell {cell_index} | {reason}"
                        )
                    else:
                        skipped_count += 1

                        log(
                            f"SKIPPED | Slide {slide_no}, Row {row_index}, "
                            f"Cell {cell_index} | {reason}"
                        )

            if progress_callback:
                progress = 20 + int((table_index / total_tables) * 65)
                progress_callback(progress)

        log("-" * 70)
        log("Saving updated PowerPoint file...")

        os.makedirs(output_folder, exist_ok=True)
        output_path = os.path.join(output_folder, exit_OUTPUT_FILE_NAME)

        prs.save(output_path)

        if progress_callback:
            progress_callback(100)

        log("Process completed successfully.")
        log(f"Cells checked: {checked_cells}")
        log(f"Exit Load cells updated: {updated_count}")
        log(f"Exit Load cells skipped: {skipped_count}")
        log(f"Saved file: {output_path}")

        message = (
            "Completed successfully!\n\n"
            f"Fund Features tables found: {total_tables}\n"
            f"Cells checked: {checked_cells}\n"
            f"Exit Load cells updated: {updated_count}\n"
            f"Exit Load cells skipped: {skipped_count}\n\n"
            f"Saved at:\n{output_path}"
        )

        return True, message

    except Exception:
        error = traceback.format_exc()
        log("ERROR occurred:")
        log(error)
        return False, error



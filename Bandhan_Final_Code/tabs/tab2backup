            self.status.setText("Output folder selected.")
            self.log(f"Output folder selected: {folder}")
            self._refresh_output_preview()

    def add_files(self):
        files, _ = QFileDialog.getOpenFileNames(self, "Select PPTX files", str(Path.home()), "PowerPoint (*.pptx)")
        if not files:
            return
        existing = set(self.get_all_paths())
        added = 0
        for file_path in files:
            if file_path not in existing:
                self.list_widget.addItem(QListWidgetItem(file_path))
                existing.add(file_path)
                added += 1
        self.status.setText(f"Added {added} file(s).")
        self.log(f"Added {added} file(s).")

    def remove_selected(self):
        items = self.list_widget.selectedItems()
        if not items:
            return
        for item in sorted(items, key=self.list_widget.row, reverse=True):
            self.list_widget.takeItem(self.list_widget.row(item))
        self.status.setText("Removed selected item(s).")
        self.log("Removed selected item(s).")

    def clear_list(self):
        self.list_widget.clear()
        self.status.setText("Cleared list.")
        self.log("Cleared list.")

    def move_selected(self, direction: int):
        selected_rows = sorted({self.list_widget.row(item) for item in self.list_widget.selectedItems()})
        if not selected_rows:
            return
        if direction < 0:
            for row in selected_rows:
                if row == 0:
                    continue
                item = self.list_widget.takeItem(row)
                self.list_widget.insertItem(row - 1, item)
                item.setSelected(True)
        else:
            for row in reversed(selected_rows):
                if row == self.list_widget.count() - 1:
                    continue
                item = self.list_widget.takeItem(row)
                self.list_widget.insertItem(row + 1, item)
                item.setSelected(True)

    def get_all_paths(self) -> list[str]:
        return [self.list_widget.item(index).text() for index in range(self.list_widget.count())]

    def merge(self):
        inputs = self.get_all_paths()
        self._refresh_output_preview()
        if not inputs:
            QMessageBox.warning(self, "No inputs", "Please add at least one PPTX file.")
            return
        if not self.output_path:
            QMessageBox.warning(self, "No output folder", "Please select an output folder.")
            return
        try:
            output_path = Path(self.output_path)
            output_path.parent.mkdir(parents=True, exist_ok=True)
            self.status.setText("Merging...")
            self.log(f"Merging started. Output: {output_path}")
            QApplication.processEvents()
            if self.rb_pdf.isChecked():
                merge_to_pdf_preserve_sizes(inputs, str(output_path))
            else:
                merge_pptx_files(inputs, str(output_path))
            self.status.setText("Merge completed successfully.")
            self.log(f"Merge completed successfully: {output_path}")
            QMessageBox.information(self, "Done", f"Merged {len(inputs)} file(s) into:\n{output_path}")
        except Exception as exc:
            self.status.setText("Merge failed.")
            self.log(f"Merge failed: {exc}")
            QMessageBox.critical(self, "Merge failed", str(exc))



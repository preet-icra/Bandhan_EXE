def validate_manual_fund_page_notes(pptx_path, notes, progress_cb=None) -> dict[str, Any]:
    def log(message: str) -> None:
        if progress_cb:
            progress_cb(message)

    pptx_path = Path(pptx_path)
    if not pptx_path.exists():
        raise FileNotFoundError(f"Input PPTX not found: {pptx_path}")

    selected_notes = [n for n in notes if n.use and n.scheme.strip() and n.shape_name.strip() and n.note.strip()]
    if not selected_notes:
        raise ValueError("No valid manual fund page note rows found.")

    prs = Presentation(str(pptx_path))
    scheme_match_count = 0
    object_match_count = 0
    creatable_count = 0
    missing_targets = []
    log("[ManualFundPage] Validation started.")

    for note_item in selected_notes:
        item_scheme_found = False
        item_object_found = False
        item_creatable = False
        for slide_index, slide in enumerate(prs.slides, start=1):
            if not text_contains_value(get_slide_text(slide), note_item.scheme):
                continue
            item_scheme_found = True
            scheme_match_count += 1
            if find_shape_by_name(slide, note_item.shape_name) is not None:
                item_object_found = True
                object_match_count += 1
                log(f"[ManualFundPage] Slide {slide_index}: found '{note_item.shape_name}' for '{note_item.scheme}'.")
            elif find_shape_by_name(slide, SECTOR_ALLOCATION_OBJECT_NAME) is not None:
                item_creatable = True
                creatable_count += 1
                log(f"[ManualFundPage] Slide {slide_index}: '{note_item.shape_name}' missing, but can be created below '{SECTOR_ALLOCATION_OBJECT_NAME}' for '{note_item.scheme}'.")
        if not item_scheme_found or (not item_object_found and not item_creatable):
            missing_targets.append(f"{note_item.scheme} / {note_item.shape_name}")

    log(f"[ManualFundPage] Validation scheme matches: {scheme_match_count}")
    log(f"[ManualFundPage] Validation object matches: {object_match_count}")
    log(f"[ManualFundPage] Validation creatable missing textboxes: {creatable_count}")
    return {
        "scheme_matches": scheme_match_count,
        "object_matches": object_match_count,
        "creatable_count": creatable_count,
        "missing_targets": missing_targets,
    }


def run_manual_fund_page_note_process(pptx_path, output_path, notes, progress_cb=None) -> dict[str, Any]:
    def log(message: str) -> None:
        if progress_cb:
            progress_cb(message)

    pptx_path = Path(pptx_path)
    output_path = Path(output_path)
    if not pptx_path.exists():
        raise FileNotFoundError(f"Input PPTX not found: {pptx_path}")

    selected_notes = [n for n in notes if n.use and n.scheme.strip() and n.shape_name.strip() and n.note.strip()]
    if not selected_notes:
        raise ValueError("No valid manual fund page notes found.")

    prs = Presentation(str(pptx_path))
    updated_count = 0
    created_count = 0
    missing_items = []
    total_notes = max(1, len(selected_notes))
    log("[ManualFundPage] Progress: 0%")

    for note_index, note_item in enumerate(selected_notes, start=1):
        item_updated = False
        for slide_index, slide in enumerate(prs.slides, start=1):
            if not text_contains_value(get_slide_text(slide), note_item.scheme):
                continue

            target_shape, target_status = find_or_create_textbox_below_sector_allocation(slide, note_item.shape_name, progress_cb=log)
            if target_shape is None:
                log(f"[ManualFundPage] Slide {slide_index}: SKIP - could not find or create '{note_item.shape_name}' for '{note_item.scheme}'.")
                continue
            if not getattr(target_shape, "has_text_frame", False):
                log(f"[ManualFundPage] Slide {slide_index}: '{note_item.shape_name}' has no text frame.")
                continue

            set_note_shape_html_text(target_shape, note_item.note.strip())
            updated_count += 1
            item_updated = True
            if target_status == "created":
                created_count += 1
                log(f"[ManualFundPage] Slide {slide_index}: created and updated '{note_item.shape_name}' for '{note_item.scheme}'.")
            else:
                log(f"[ManualFundPage] Slide {slide_index}: updated '{note_item.shape_name}' for '{note_item.scheme}'.")

        if not item_updated:
            missing_items.append(f"{note_item.scheme} / {note_item.shape_name}")
        log(f"[ManualFundPage] Progress: {int((note_index / total_notes) * 90)}%")

    output_path.parent.mkdir(parents=True, exist_ok=True)
    prs.save(str(output_path))
    log(f"[ManualFundPage] Saved: {output_path}")
    log("[ManualFundPage] Progress: 100%")
    return {"output_path": output_path, "objects_updated": updated_count, "objects_created": created_count, "missing_items": missing_items}



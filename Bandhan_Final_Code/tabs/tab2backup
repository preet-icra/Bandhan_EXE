from PyQt6.QtWidgets import QListWidget, QListWidgetItem, QRadioButton, QButtonGroup


def merge_pptx_files(input_paths: list[str], output_path: str) -> None:
    """Merge PPTX files into one PPTX using Microsoft PowerPoint COM.

    Fix for the error shown in the app:
        PowerPoint/COM error: Application.Visible : Invalid request. Hiding the application window is not allowed.
        python-pptx-merger error: 'str' object has no attribute 'getvalue'

    The reliable fix is:
    1. Do NOT hide PowerPoint. Keep ppt.Visible = True.
    2. Use PowerPoint's native Slides.InsertFromFile method for PPTX merging.
    3. Use python-pptx-merger only as a last fallback, with safe type handling.

    Notes:
    - The merged PPTX uses the first PPTX file's slide size/theme as the output deck base.
    - Microsoft PowerPoint must be installed for the COM method.
    """
    if not input_paths:
        raise ValueError("No input files selected.")

    normalized_inputs: list[str] = []
    for raw_path in input_paths:
        pptx_path = Path(raw_path).resolve()
        if not pptx_path.is_file():
            raise FileNotFoundError(f"Input file not found: {pptx_path}")
        if pptx_path.suffix.lower() != ".pptx":
            raise ValueError(f"Not a PPTX file: {pptx_path}")
        normalized_inputs.append(str(pptx_path))

    output_obj = Path(output_path).resolve()
    output_obj.parent.mkdir(parents=True, exist_ok=True)

    # If output exists, remove it first. PowerPoint can fail silently when saving over a locked/old file.
    if output_obj.exists():
        try:
            output_obj.unlink()
        except Exception as exc:
            raise RuntimeError(f"Cannot overwrite output file. Please close it if open: {output_obj}\n{exc}") from exc

    # ------------------------------------------------------------------
    # Preferred method: Microsoft PowerPoint COM
    # ------------------------------------------------------------------
    com_error_text = ""
    try:
        import win32com.client

        ppt = win32com.client.Dispatch("PowerPoint.Application")

        # IMPORTANT FIX:
        # Do not set ppt.Visible = 0. Some PowerPoint installations reject hiding the application:
        # "Application.Visible : Invalid request. Hiding the application window is not allowed."
        ppt.Visible = True

        presentation = None
        try:
            # Open the first deck as the base deck. WithWindow=True is more reliable with Visible=True.
            presentation = ppt.Presentations.Open(
                normalized_inputs[0],
                ReadOnly=False,
                Untitled=False,
                WithWindow=True,
            )

            # Insert every remaining deck after the last slide of the base deck.
            for next_pptx in normalized_inputs[1:]:
                presentation.Slides.InsertFromFile(next_pptx, presentation.Slides.Count)

            # 24 = ppSaveAsOpenXMLPresentation (.pptx)
            presentation.SaveAs(str(output_obj), 24)

        finally:
            if presentation is not None:
                presentation.Close()
            ppt.Quit()

        if output_obj.exists() and output_obj.stat().st_size > 0:
            return

        raise RuntimeError(f"PowerPoint merge completed, but output file was not created: {output_obj}")

    except Exception as com_exc:
        com_error_text = str(com_exc)

    # ------------------------------------------------------------------
    # Fallback method: python-pptx-merger
    # This is kept only as fallback. Some versions fail internally with:
    # 'str' object has no attribute 'getvalue'
    # ------------------------------------------------------------------
    try:
        from pptx_merger import Merger
    except ImportError as exc:
        raise RuntimeError(
            "PPTX merge failed using Microsoft PowerPoint COM, and python-pptx-merger is not installed.\n\n"
            f"PowerPoint/COM error:\n{com_error_text}\n\n"
            "Install fallback package with:\n"
            "pip install python-pptx-merger"
        ) from exc

    try:
        merger = Merger()
        merged_doc = merger.merge_slides(normalized_inputs)

        # Some versions return a file path.
        if isinstance(merged_doc, (str, Path)):
            merged_path = Path(merged_doc)
            if merged_path.is_file():
                shutil.copyfile(str(merged_path), str(output_obj))
                return
            raise RuntimeError(f"python-pptx-merger returned a non-file path/string: {merged_doc}")

        # Some versions return BytesIO-like object.
        if hasattr(merged_doc, "getvalue") and callable(getattr(merged_doc, "getvalue")):
            data = merged_doc.getvalue()
        else:
            data = merged_doc

        if isinstance(data, (bytes, bytearray)):
            with open(output_obj, "wb") as file:
                file.write(bytes(data))
            return

        # Some versions might return a file-like object.
        if hasattr(data, "read") and callable(getattr(data, "read")):
            content = data.read()
            if isinstance(content, (bytes, bytearray)):
                with open(output_obj, "wb") as file:
                    file.write(bytes(content))
                return

        raise RuntimeError(f"Unexpected python-pptx-merger output type: {type(merged_doc)}")

    except Exception as fallback_exc:
        raise RuntimeError(
            "PPTX merge failed with both available methods.\n\n"
            "PowerPoint/COM method failed with:\n"
            f"{com_error_text}\n\n"
            "python-pptx-merger fallback failed with:\n"
            f"{fallback_exc}\n\n"
            "Recommended fix:\n"
            "1. Make sure Microsoft PowerPoint is installed.\n"
            "2. Close all open PowerPoint windows/files.\n"
            "3. Run the app again; PowerPoint will open briefly during merging."
        ) from fallback_exc


def export_pptx_to_pdf_via_powerpoint(pptx_path: str, pdf_path: str) -> None:
    """Export PPTX to PDF using Microsoft PowerPoint COM automation."""
    try:
        import win32com.client
    except ImportError as exc:
        raise RuntimeError(
            "pywin32 not installed. Run: pip install pywin32\n"
            "PDF export requires Windows with Microsoft PowerPoint installed."
        ) from exc
    ppt = win32com.client.Dispatch("PowerPoint.Application")
    ppt.Visible = 0
    presentation = None
    try:
        presentation = ppt.Presentations.Open(pptx_path, WithWindow=False)
        presentation.SaveAs(pdf_path, 32)
    finally:
        if presentation is not None:
            presentation.Close()
        ppt.Quit()


def merge_pdfs(pdf_paths: list[str], output_pdf: str) -> None:
    """Merge PDFs while preserving page sizes."""
    try:
        from pypdf import PdfMerger
    except ImportError as exc:
        raise RuntimeError("pypdf not installed. Run: pip install pypdf") from exc
    os.makedirs(os.path.dirname(output_pdf) or ".", exist_ok=True)
    merger = PdfMerger()
    try:
        for path in pdf_paths:
            merger.append(path)
        with open(output_pdf, "wb") as file:
            merger.write(file)
    finally:
        merger.close()


def merge_to_pdf_preserve_sizes(input_pptx_paths: list[str], output_pdf: str) -> None:
    """Convert each PPTX to PDF preserving its slide size, then merge PDFs."""
    if not input_pptx_paths:
        raise ValueError("No input files selected.")
    for path in input_pptx_paths:
        if not os.path.isfile(path):
            raise FileNotFoundError(f"Input file not found: {path}")
        if not path.lower().endswith(".pptx"):
            raise ValueError(f"Not a PPTX file: {path}")
    with tempfile.TemporaryDirectory(prefix="pptx_merge_") as tmpdir:
        pdfs = []
        for index, pptx_path in enumerate(input_pptx_paths, start=1):
            pdf_out = os.path.join(tmpdir, f"{index:03d}_{Path(pptx_path).stem}.pdf")
            export_pptx_to_pdf_via_powerpoint(pptx_path, pdf_out)
            pdfs.append(pdf_out)
        merge_pdfs(pdfs, output_pdf)



def _combined6_log(self, text: str) -> None:
    message = str(text)
    targets = []
    if hasattr(self, "section_tabs"):
        idx = self.section_tabs.currentIndex()
        if idx == 0 and hasattr(self, "merge_log_box"):
            targets.append(self.merge_log_box)
        elif idx == 1 and hasattr(self, "age_log_box"):
            targets.append(self.age_log_box)
        elif idx == 2 and hasattr(self, "manual_log_box"):
            targets.append(self.manual_log_box)
        elif idx == 3 and hasattr(self, "exitload_log_box"):
            targets.append(self.exitload_log_box)
        elif idx == 4 and hasattr(self, "sector_log_box"):
            targets.append(self.sector_log_box)
        elif idx == 5 and hasattr(self, "gold_silver_log_box"):
            targets.append(self.gold_silver_log_box)
    if not targets and hasattr(self, "log_box"):
        targets.append(self.log_box)
    for box in targets:
        box.append(message)
        box.ensureCursorVisible()


